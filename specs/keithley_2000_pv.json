 "source": {
  "document": "Keithley Model 2000 Multimeter Calibration Manual (2000-905-01 Rev. F)",
  "pages": "1-3 to 1-13 (Tables 1-2 to 1-6)",
  "note": "One interval only: 1 year, 18-28 C (the manual calculates the limits from the one-year accuracy specification and does not include calibrator uncertainty, p. 1-5; if a reading is slightly outside, the manual says to recalculate limits from the 2000 and the calibrator specifications). The 90-day and 24-hour limits are not printed in the verification tables."
 },
 "periods": [
  "1y"
 ],
 "default_period": "1y",
 "front_rear_switch": true,
 "equipment": {
  "dc_ac_source": "Fluke 5700A or equivalent (Table 1-1); this procedure drives a Fluke 5522A or 5560A",
  "high_voltage_ac": "Fluke 5725A amplifier, only for 700 V at 50 kHz (otherwise 219 V at 50 kHz)",
  "resistance": "4-wire; 100 Mohm 2-wire"
 },
 "general": [
  "Warm up the 2000 for at least one hour before the verification (p. 1-3); allow the test equipment its own warm-up time.",
  "Ambient 18 to 28 C, relative humidity below 80 % (p. 1-3); line 100 / 120 / 220 / 240 V +/-10 %, 45 to 66 Hz or 360 to 440 Hz.",
  "Restore factory defaults first (Speed: medium, Filter: 10 readings, p. 1-5); front panel inputs selected with the INPUTS switch (p. 1-6).",
  "Never use autorange: set the range for each test signal (p. 1-6). Calibrator in operate; always let the source signal settle before a reading.",
  "Do not connect test equipment through a scanner or other switching equipment (p. 1-6).",
  "Max common-mode voltage (INPUT LO to chassis) 500 V peak; do not exceed 1000 V peak between INPUT HI and LO, or 8 x 10^7 V-Hz (p. 1-8 caution)."
 ],
 "measure": {
  "nplc": 1,
  "filter_state": "ON",
  "filter_count": 10,
  "filter_type": "REPeat",
  "ac_bandwidth": 30,
  "note": "Speed medium = 1 PLC (DC, ohms, DC current) and detector bandwidth 30 (AC, \"Medium\" rate) with the digital filter on, 10 readings: the factory default operating conditions the manual restores (p. 1-5, Table 2-2 of the User Manual). The filter is the REPEAT (one-shot) type so each :READ? is ten fresh conversions; the specification sheet states MED (1 PLC) with a filter of 10 as its DC condition."
 },
 "prep": {
  "dcv_rel_zero": {
   "kind": "DCV",
   "range": 0.1,
   "nominal": 0.0,
   "page": "1-7",
   "text": "Select DC volts, 100 mV range. Set the calibrator output to 0.00000 mV DC and allow the reading to settle, then enable the 2000 REL mode. Leave REL enabled for the remainder of the DC volts verification tests (p. 1-7 steps 2 to 4). REL must be DISABLED for AC volts (p. 1-8 step 3)."
  }
 },
