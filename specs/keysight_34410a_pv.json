  "document": "Keysight 34410A/11A/L4411A Service Guide",
  "pages": "68-87 (Verification Tests, PDF pages 70-89)",
  "note": "Three intervals are printed (24 hour, 90 day, 1 year). The manual compares acceptance results with the 90 day limits and uses the 24 hour limits only within 24 hours of an adjustment (p. 66); the default here is the 1 year limit (calibration interval). Without adjustment the manual asks for a guard band of no more than 80 % of the specification (p. 66): not applied. 1000 V DC: the 1 year limit includes the footnote 5 adder, the 24 hour and 90 day limits do not (as printed)."
 },
 "periods": [
  "24h",
  "90d",
  "1y"
 ],
 "default_period": "1y",
 "front_rear_switch": true,
 "equipment": {
  "zero": "Keysight 34172B low-thermal short (4-terminal)",
  "dc_ac_source": "Fluke 5720A (manual); this procedure drives a Fluke 5522A, 5560A or 5520A",
  "frequency": "Keysight 33220A (manual); the calibrator's own AC voltage output at the stated frequency is used",
  "capacitance": "IET SCA-1uF",
  "accuracy_requirement": "<1/5 of the instrument 24 hour specification (p. 64)"
 },
 "general": [
  "Ambient 18 to 28 C (ideally 23 C +/- 2 C), relative humidity below 80 % (p. 67).",
  "Allow a 90 minute warm-up with a copper short connected (p. 67).",
  "Shielded twisted-pair PTFE cables, shields to earth ground at one place (p. 67).",
  "Select 100 NPLC for DC volts, DC current and resistance; the 3 Hz (slow) AC filter for AC volts and AC current (pp. 69-82).",
  "Without adjustment use a guard band of no more than 80 % of the specification (p. 66): not applied."
 ],
