 "firmware": {
  "note": "Table 3-1 note, p. 3-4: STEP10 to STEP13 differ between firmware A19 and A20. A19 and earlier have no 10 Mohm step; their steps 10-12 are the 10 mA, 100 mA and 1 A steps (A20 and later: 11-13); there is no step 13 on A19 and earlier. AC steps are the same on both.",
  "idn": "Keithley Model 2000 User Manual (2000-900 Rev. J) (common command *IDN?, PDF p. 122): *IDN?: KEITHLEY INSTRUMENTS INC., MODEL 2000, xxxxxxx, yyyyy/zzzzz (yyyyy = firmware revision of the digital board ROM, zzzzz = display board ROM); the revision text format (e.g. A19) is UNVERIFIED on a real meter.",
  "boundary": "A20"
 },
 "sequence": [
  {
   "id": "prepare",
   "text": "DCV function, SLOW rate (10 PLC), INPUTS front (p. 2-14 steps 3-4)"
  },
  {
   "id": "code",
   "text": ":CAL:PROT:CODE <code> sent ONCE (p. 2-14 step 5; p. 3-6: \"sent only once ... Do not send :CODE before each calibration step\")"
  },
  {
   "id": "init",
   "text": ":CAL:PROT:INIT sent ONCE (p. 2-14 step 6; p. 3-7)"
  },
  {
   "id": "steps",
   "text": "DC then AC steps in the order of Tables 2-8 to 2-12 (a complete calibration; DC only or AC only are allowed, p. 2-14 note); wait for each step to finish (p. 3-20, *OPC?)"
  },
  {
   "id": "dates",
   "text": ":CAL:PROT:DATE and :CAL:PROT:NDUE (p. 2-19); errors +438 / +439 if they are not set (Table B-1)"
  },
  {
   "id": "save",
   "text": ":CAL:PROT:SAVE (p. 2-19, p. 3-8): stores the constants in EEROM; \"only temporary unless :SAVE is sent\""
  },
  {
   "id": "lock",
   "text": ":CAL:PROT:LOCK (p. 2-19, p. 3-7); :CAL:PROT:LOCK? 0 = locked, 1 = unlocked"
  }
 ],
