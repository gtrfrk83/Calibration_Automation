 "source": {
  "document": "Fluke 287/289 True-rms Digital Multimeters Calibration Manual",
  "pages": "14-20 (printed): functional checks pp. 15-16, Table 3 p. 17, Table 4 pp. 17-20",
  "cite": "Fluke 287/289 Calibration Manual, Performance Tests, pp. 14-20 (Tables 3 and 4)",
  "limits": "Manufacturer display-reading limits (Table 4)",
  "note": "Display-reading limits as printed (Tables 3 and 4). The manual uses a Fluke 5520A with the scope option; a 5522A or 5560A can be used where it makes the point (it refuses outputs it cannot make). Steps 25, 29 and 41 are set on the calibrator by hand. Allow the meter to reach room temperature first (can take several hours). Readings can be typed or read over the IR cable; with IR the program also checks the meter's function, range and REL / Low Pass state before recording."
 },
 "models": {
  "287": {
   "name": "Fluke 287",
   "brand": "Fluke",
   "model_note": "Fluke 287 True-rms logging multimeter"
  },
  "289": {
   "name": "Fluke 289",
   "brand": "Fluke",
   "model_note": "Fluke 289 True-rms industrial logging multimeter"
  }
 },
 "groups": {
  "VOHM": {
   "title": "Connect for voltage, resistance (2-wire) and capacitance",
   "summary": "Calibrator NORMAL HI / LO (5560A: OUTPUT V/Ω) to the meter V and COM inputs.",
   "steps": [
    [
     "Standby",
     "The calibrator is in STANDBY while you rewire."
    ],
    [
     "Connect",
     "Calibrator NORMAL HI / LO (5560A: OUTPUT V/Ω HI / LO) to the meter V (red) and COM (black) inputs."
    ],
    [
     "Calibrator",
     "Ohms compensation OFF (COMP off) and the auxiliary cable removed (manual, before step 15)."
    ]
   ]
  },
  "OHM4": {
   "title": "Ohms: 2-wire COMP, 4-wire connection",
   "summary": "Calibrator 2-wire COMP; NORMAL HI/LO and AUX HI/LO (sense) leads to the meter V and COM inputs.",
   "steps": [
    [
     "Standby",
     "The calibrator is in STANDBY while you rewire."
    ],
    [
     "Calibrator",
     "Set ohms compensation to 2-wire COMP on the calibrator front panel (the program does not set it)."
    ],
    [
     "Connect",
     "Connect in the 4-wire configuration: NORMAL HI and AUX HI to the meter V input, NORMAL LO and AUX LO to COM (the calibrator senses at the meter terminals)."
    ]
   ],
   "caution": "Ohms compensation is set by you, not by the program: check it before continuing."
  },
  "UAMP": {
   "title": "Connect for µA / mA",
   "summary": "Calibrator AUX output (5560A: VI AUX) to the meter mA/µA and COM inputs; COMP off.",
   "steps": [
    [
     "Standby",
     "The calibrator is in STANDBY while you rewire."
    ],
    [
     "Connect",
     "Calibrator AUX HI / LO (5560A: VI AUX and OUTPUT LO) to the meter mA/µA (red) and COM inputs."
    ]
   ],
   "caution": "The mA/µA input is fused at 0.44 A: do not exceed the point being tested."
  },
  "AMP10": {
   "title": "Connect for A",
   "summary": "Calibrator 20 A output (5560A: 30A) to the meter A and COM inputs.",
   "steps": [
    [
     "Standby",
     "The calibrator is in STANDBY while you rewire."
    ],
    [
     "Connect",
     "Calibrator 20 A output and AUX LO (5560A: 30A and OUTPUT LO) to the meter A (red) and COM inputs, with leads rated for 10 A."
    ]
   ],
   "caution": "The A input is fused at 11 A."
  },
  "TEMP": {
   "title": "Connect the thermocouple",
   "summary": "On the meter: mV ⎓ / temperature position, temperature, °C; select Offset and set it to 000.0, then close the Offset window. K-type thermocouple (mini-plug both ends) from the calibrator TC output to the Fluke 80AK in the meter V and COM inputs. The meter must be within ±1 °C of ambient (can take hours); allow the connections 2 minutes to stabilize.",
   "steps": [
    [
     "Standby",
     "The calibrator is in STANDBY while you connect."
    ],
    [
     "Meter",
     "On the meter: mV ⎓ / temperature position, temperature, °C; select Offset and set it to 000.0, then close the Offset window."
    ],
    [
     "Connect",
     "K-type thermocouple (mini-plug both ends) from the calibrator TC output to the Fluke 80AK in the meter V and COM inputs. The meter must be within ±1 °C of ambient (can take hours); allow the connections 2 minutes to stabilize."
    ]
   ]
  }
 },
